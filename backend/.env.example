APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/refereerequest?sslmode=disable
JWT_SECRET=replace-with-strong-secret
JWT_TTL_MINUTES=60
OTEL_EXPORTER=stdout
CORS_ALLOWED_ORIGINS=http://localhost:3000
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./tmp/storage
UPLOAD_MAX_BYTES=10485760
RESEND_API_KEY=
RESEND_FROM_EMAIL=RefereeRequest <noreply@refereerequest.com>
REMINDER_LEAD_HOURS=72
NOTIFICATION_DISPATCH_TOKEN=change-me
